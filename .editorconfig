# EditorConfig configuration for Cloud-Native Ride Dispatch Monorepo
# Indentation policy:
# Go files use tabs (standard Go convention strictly enforced by gofmt).
# TypeScript, JavaScript, JSON, YAML, and Markdown use 2-space indentation.
# This divergence is intentional to respect the idiomatic standards of each respective language ecosystem.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{ts,js,mjs,cjs,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
